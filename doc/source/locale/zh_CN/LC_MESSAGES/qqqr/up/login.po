#: of qqqr.up.web.UpWebSession:1
msgid "Session state for UP login."
msgstr "UP 登录的 session 状态。"

#: of qqqr.up.web.UpWebSession:3
msgid ""
"Stores verification results, check responses, SMS ticket, and login history. Properties expose "
"the current verification code and session id needed for login requests."
msgstr "存储验证结果、check 响应、短信票据和登录历史。属性暴露当前验证码和登录请求所需的 session id。"

#: of qqqr.up.web.UpWebSession.set_check_result:1
msgid "Store the check API response and update session state."
msgstr "存储 check API 响应并更新 session 状态。"

#: of qqqr.up.web.UpWebSession.pastcode:1
msgid "The response code from the last login attempt, or 0 if none."
msgstr "上次登录尝试的响应码，如果没有则为 0。"

#: of qqqr.up.web.UpWebSession.sid:1
msgid "The login session id from the check response."
msgstr "来自 check 响应的登录 session id。"

#: of qqqr.up.web.UpWebSession.code:1
msgid "The current verification code (verify result > check result)."
msgstr "当前验证码（verify 结果优先于 check 结果）。"

#: of qqqr.up.web.UpWebSession.verifycode:1
msgid "The current verification string (verify result > check result)."
msgstr "当前验证字符串（verify 结果优先于 check 结果）。"

#: of qqqr.up.web.UpWebSession.verifysession:1
msgid "The current verification session (verify result > check result)."
msgstr "当前验证 session（verify 结果优先于 check 结果）。"


msgstr "`pass_vc` 函数用于通过 Tcaptcha 验证。当 :meth:`.try_login` 返回 :obj:`StatusCode.NeedCaptcha` 码时调用。"

#: of qqqr.up.web.UpWebSession.pass_vc:5
msgid "the :class:`Captcha` object"
msgstr ":class:`Captcha` 对象"

#: of qqqr.up.web.UpWebSession.pass_vc:6
msgid "if cannot solve this captcha"
msgstr "如果无法解决此验证码"

#: of qqqr.up.web.UpWebSession.pass_vc:7
msgid "if failed to pass captcha"
msgstr "如果未能通过验证码"


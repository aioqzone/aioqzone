msgid "aioqzone Exceptions"
msgstr "aioqzone 异常"

#: aioqzone.exception:1 of
msgid "aioqzone exception hierarchy."
msgstr "aioqzone 异常层次结构。"

#: aioqzone.exception:3 of
msgid ""
"Defines :class:`QzoneError` (HTTP OK but Qzone returned an error code), "
":class:`UnexpectedLoginError`, and :class:`CorruptError`."
msgstr "定义 :class:`QzoneError`、:class:`UnexpectedLoginError` 和 :class:`CorruptError`。"

#: aioqzone.exception.QzoneError:1 of
msgid "HTTP OK, but Qzone returns an error code."
msgstr "HTTP 正常，但 Qzone 返回了错误码。"

#: aioqzone.exception.UnexpectedLoginError:1 of
msgid "Represents that an unexpected error happens in login process."
msgstr "表示登录过程中发生了意外错误。"

#: aioqzone.exception.CorruptError:1 of
msgid "Data corrupted in transfer."
msgstr "传输过程中数据损坏。"


msgstr ""

#: aioqzone.api.web.model.QzoneWebAPI.floatview_photo_list:14 of
msgid "album details"
msgstr "相册详情"

#: aioqzone.api.web.model.QzoneWebAPI.floatview_photo_list:17 of
msgid ""
"This api is a 'slow' api, means it always returns an error code, requesting a retry a moment "
"later. Use :meth:`.emotion_msgdetail` to get raw photo/video in a feed."
msgstr "此 API 是一个"慢"API，即它总是返回错误码，要求稍后重试。使用 :meth:`.emotion_msgdetail` 获取 feed 中的原始照片/视频。"

#: aioqzone.api.web.model.QzoneWebAPI.get_feeds_count:1 of
msgid "Get feeds update count (new feeds, new photos, new comments, etc)"
msgstr "获取 feed 更新数量（新 feed、新照片、新评论等）"

#: aioqzone.api.web.model.QzoneWebAPI.get_feeds_count:7 of
msgid ":py:class:`~aioqzone.model.response.web.FeedsCount`"
msgstr ""

#: aioqzone.api.web.model.QzoneWebAPI.get_feeds_count:8 of
msgid "update counts"
msgstr "更新计数"

#: aioqzone.api.web.model.QzoneWebAPI.get_feeds_count:11 of
msgid ""
"This api is also the 'keep-alive' signal to avoid cookie from expiring. Call this api every 300s"
" can help keep cookie alive."
msgstr "此 API 也是避免 cookie 过期的"保活"信号。每 300 秒调用一次有助于保持 cookie 有效。"


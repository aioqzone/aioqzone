msgstr "使用 `aux` 替代之前的 `trans` 关键字。"

#: aioqzone.api.web.model.QzoneWebAPI.floatview_photo_list:1 of
msgid "Get detail of an album, including raw image url."
msgstr "获取相册详细信息，包括原始图片 URL。"

#: aioqzone.api.web.model.QzoneWebAPI.floatview_photo_list:4 of
msgid "Necessary album data"
msgstr "必要的相册数据"

#: aioqzone.api.web.model.QzoneWebAPI.floatview_photo_list:6 of
msgid "pic num"
msgstr "图片数量"

#: aioqzone.api.web.model.QzoneWebAPI.floatview_photo_list:11 of
